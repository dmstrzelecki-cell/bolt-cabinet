# Family Search — NON-secret site settings for scripts/install.sh.
# install.sh copies this to /etc/family-search/site.env on first run; edit
# that copy with values from PREFLIGHT.md, then re-run install.sh.
# Secrets never go here (they live in /etc/family-search/*.env, mode 600).

# Public hostname (the one approved subdomain exception).
PUBLIC_ORIGIN=https://search.thestrzs.net

# LAN IP of the host/CT that runs cloudflared for the existing tunnel.
# Port 8080 accepts connections ONLY from this address. Until it is set,
# 8080 is closed to the LAN (the app is not live, which is the safe default).
CLOUDFLARED_IP=__SET_ME__

# Address or CIDR allowed to SSH in (e.g. the Proxmox host). Leave __SET_ME__
# to allow no SSH at all; `pct enter <CTID>` from the host always works.
ADMIN_SSH_SOURCE=__SET_ME__

# AdGuard resolver.
DNS_IP=192.168.0.40

# CT101's LAN IP (Immich listens on 2283). Only the backend user may reach it.
IMMICH_IP=__SET_ME__

# Meilisearch release to install. MEILI_SHA256 is optional: when empty, the
# installer verifies against the sha256 digest GitHub publishes for the
# release asset, and refuses to install if it cannot get one.
MEILI_VERSION=v1.15.2
MEILI_SHA256=
