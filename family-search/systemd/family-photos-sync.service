[Unit]
Description=Family Search nightly photo-album sync (restricted Immich user)
After=network-online.target meilisearch.service

[Service]
Type=oneshot
User=fs-web
Group=fs-web
SupplementaryGroups=fsearch
WorkingDirectory=/opt/family-search/backend
EnvironmentFile=/etc/family-search/backend.env
ExecStart=/opt/family-search/venv/bin/python -m familysearch.cli sync-photos
ReadWritePaths=/var/lib/family-search/app /var/lib/family-search/spool
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=768M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
UMask=0027
